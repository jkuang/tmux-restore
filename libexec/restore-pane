#!/usr/bin/env bash
# Run in a restored pane with local, validated snapshot paths and pane metadata.
set -u

root=${BASH_SOURCE[0]%/*}/..
source "$root/lib/common.sh" || exit 1
source "$root/shell/command-record.sh" || exit 1
source "$root/lib/command.sh" || exit 1
source "$root/lib/restore-prompt.sh" || exit 1

if [[ $# -lt 4 || $# -gt 6 ]]; then
    printf '%s\n' 'Usage: restore-pane WORKING_DIRECTORY SCROLLBACK_FILE SAVED_EPOCH SHELL [COMMAND_RECORD [PROCESS_HINT_FILE]]' >&2
    exit 2
fi

directory=$1 scrollback=$2 saved_at=$3 pane_shell=$4 record=${5:-} process_hint=${6:-}
TR_PLATFORM=$(uname -s)
pending=
alternate=0

publish_prompt() {
    local stage
    _tmux_restore_record_context 2>/dev/null || return 1
    [[ $_tmux_restore_record_pane_pid == "$$" ]] || return 1
    (umask 077; mkdir -p -- "$_tmux_restore_record_dir") || return 1
    stage=$(mktemp -d "$_tmux_restore_record_dir/.pending.XXXXXXXX") || return 1
    if { ln -- "$scrollback" "$stage/screen" || cp -- "$scrollback" "$stage/screen"; } &&
        { ln -- "$record" "$stage/command" || cp -- "$record" "$stage/command"; } &&
        mv -- "$stage" "$_tmux_restore_record_dir/pending"; then
        pending=$_tmux_restore_record_dir/pending
    else
        rm -rf -- "$stage"
        return 1
    fi
}

finish_prompt() {
    if (( alternate )); then printf '\033[?1049l'; alternate=0; fi
    [[ -n $pending && -d $pending ]] || return 0
    # Unpublish the pending record before removing its private files. A save
    # sees either its complete prior state or the actual, now active pane.
    if mv -- "$pending" "$pending.closed.$$"; then rm -rf -- "$pending.closed.$$"; fi
    pending=
    command tmux set-option -g @tmux-restore-dirty 1 >/dev/null 2>&1 || :
}

print_text() { LC_ALL=C tr -d '\000-\010\013-\037\177'; }

if ! cd -- "$directory"; then
    cd -- "$HOME" || exit 1
fi
if [[ -f $scrollback && -r $scrollback ]]; then
    print_text < "$scrollback"
fi

if [[ -n $record && -r $record ]] && tmux_restore_read_command_file "$record" &&
    [[ -d $tmux_restore_command_directory ]] && command -v "$tmux_restore_command_shell" >/dev/null; then
    publish_prompt || :
    trap finish_prompt EXIT
    trap ':' INT
    if [[ -t 1 && ${TERM:-dumb} != dumb ]]; then
        # Keep the temporary prompt out of the primary screen and scrollback.
        printf '\033[?1049h'
        alternate=1
        if [[ -r $scrollback ]]; then
            height=${LINES:-24}
            if [[ $height =~ ^[0-9]{1,5}$ ]] && (( height > 5 )); then
                tail -n "$((height - 5))" -- "$scrollback" | print_text
            fi
        fi
    fi
    if tmux_restore_prompt "$(tr_timestamp "$tmux_restore_command_time")" "$(tr_timestamp "$saved_at")" \
        "$tmux_restore_command_text" "$tmux_restore_command_directory"; then
        # Retain the approved command while it runs.
        if [[ -n $pending ]] &&
            (umask 077; cp -- "$pending/command" "$_tmux_restore_record_dir/slot.1"); then
            _tmux_restore_set_active "$_tmux_restore_slot_seq" || :
        fi
        finish_prompt
        trap - EXIT INT
        tmux_restore_replay "$tmux_restore_command_shell" "$tmux_restore_command_directory" "$tmux_restore_command_text"
        if [[ -n ${_tmux_restore_record_dir:-} ]]; then _tmux_restore_set_active 0 || :; fi
    else
        finish_prompt
        trap - EXIT INT
    fi
else
    printf '\nTmux restored · saved %s' "$(tr_timestamp "$saved_at")"
    if [[ -r $process_hint ]]; then
        printf ' · last process: '
        LC_ALL=C tr -d '\000-\037\177' < "$process_hint"
    fi
    printf '\n'
fi

exec "$pane_shell" -i
